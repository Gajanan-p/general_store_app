<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EEEEEE">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_16dp">

        <TextView
            android:id="@+id/text_added_item_info_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Parle crackers" />

        <TextView
            android:id="@+id/text_added_item_info_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_added_item_info_name"
            tools:text="Purchase Price: 110.00" />

        <View
            android:id="@+id/divider_v"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:background="#DDDDDD"
            app:layout_constraintBottom_toBottomOf="@id/text_added_item_info_price"
            app:layout_constraintStart_toEndOf="@id/text_added_item_info_price"
            app:layout_constraintTop_toTopOf="@id/text_added_item_info_price" />

        <TextView
            android:id="@+id/text_added_item_info_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/text_added_item_info_price"
            app:layout_constraintStart_toEndOf="@id/divider_v"
            app:layout_constraintTop_toTopOf="@id/text_added_item_info_price"
            tools:text="In Stock: 1000" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray"
            android:layout_marginTop="@dimen/_5dp"
            app:layout_constraintTop_toBottomOf="@+id/text_added_item_info_stock"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
