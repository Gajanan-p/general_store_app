<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".ui.view.BillingFragment">

    <!-- Sticky Top Row -->
    <LinearLayout
        android:id="@+id/topStickyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_main"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invoice_no_label"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"/>
            <TextView
                android:id="@+id/text_billing_invoice_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2 ▼"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/surface_stroke"
            android:layout_marginHorizontal="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date_label"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"/>
            <TextView
                android:id="@+id/text_billing_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="07/06/2026 ▼"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topStickyRow"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Party Balance -->
            <TextView
                android:id="@+id/text_party_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                tools:text="Party Balance: ₹ 0.00"
                android:textSize="12sp"
                android:visibility="gone"
                android:textColor="@color/secondary_text"/>

            <!-- Customer Field Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomer"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Customer *">
                    <AutoCompleteTextView
                        android:id="@+id/edit_billing_customer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_customer_billing"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Add"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_input_add"/>
            </LinearLayout>

            <!-- Phone Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:hint="Phone Number">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_billing_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Billed Items Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="16dp"
                android:padding="5dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/baseline_check_circle_24"/>
                <TextView
                    style="under"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Billed Items"
                    android:textColor="@color/secondary_text"
                    android:textStyle="bold"/>


            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/text_total_amount"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:background="#D0D0D0"/>

            <!-- Items List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_billing_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_billing_product"
                android:layout_marginTop="@dimen/_5dp"
                tools:itemCount="1"/>

            <!-- Item Summary Row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/lbl_total_disc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Disc: 0.0"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/lbl_total_tax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Tax Amt: 0.0"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/lbl_total_qty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_total_disc"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/lbl_subtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lbl_total_tax"
                    android:layout_marginTop="4dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Add Items Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_items"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/add_items"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/on_brand_accent"
                app:iconTint="@color/on_brand_accent"
                app:backgroundTint="@color/brand_accent"
                app:cornerRadius="16dp"
                app:elevation="0dp"
                app:iconGravity="textStart"
                app:icon="@drawable/baseline_add_circle_24"/>

            <!-- Bottom Summary Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="16dp"/>

                <!-- Total Amount Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Amount"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/text_total_amount"
                        android:layout_marginEnd="32dp"
                        android:text="₹"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:id="@+id/text_total_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"/>
                    <View
                        android:layout_width="120dp"
                        android:layout_height="1dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/text_total_amount"
                        android:layout_marginTop="4dp"
                        android:background="#D0D0D0"/>
                </RelativeLayout>

                <!-- Received Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <CheckBox
                        android:id="@+id/cb_received"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Received"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/edit_received_amount"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="32dp"
                        android:text="₹"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <EditText
                        android:id="@+id/edit_received_amount"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:inputType="numberDecimal"
                        android:gravity="end"
                        android:textSize="18sp"/>
                    <View
                        android:layout_width="120dp"
                        android:layout_height="1dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/edit_received_amount"
                        android:layout_marginTop="10dp"
                        android:background="#D0D0D0"/>
                </RelativeLayout>

                <!-- Balance Due Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balance Due"
                        android:textSize="18sp"
                        android:textColor="@color/green"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/text_balance_due"
                        android:layout_marginEnd="32dp"
                        android:text="₹"
                        android:textSize="18sp"
                        android:textColor="@color/green"/>
                    <TextView
                        android:id="@+id/text_balance_due"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/green"/>
                </RelativeLayout>

                <!-- Action Buttons (Cancel/Save) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_billing_cancel"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Cancel"
                        android:textColor="@color/secondary_text"
                        app:strokeColor="@color/surface_stroke"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_billing_save"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/save"
                        android:backgroundTint="@color/brand_accent"
                        android:textColor="@color/black"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
